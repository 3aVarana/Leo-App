#!/bin/sh
#
# Formats staged Swift files with SwiftFormat before each commit.
# Enable once per clone:  git config core.hooksPath .githooks
# Skip for a single commit: git commit --no-verify

# GUI clients (Xcode, Fork, etc.) don't load the shell profile, so Homebrew may be missing from PATH.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v swiftformat >/dev/null 2>&1; then
    echo "pre-commit: swiftformat not found. Install it with: brew install swiftformat" >&2
    exit 1
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')
[ -z "$staged" ] && exit 0

failed=""
formatted=""

# Split on newlines only so paths with spaces survive.
IFS='
'
for file in $staged; do
    if git diff --quiet -- "$file"; then
        # Fully staged: format in place and re-stage.
        before=$(git hash-object "$file")
        swiftformat --quiet "$file" || { failed="$failed\n  $file"; continue; }
        if [ "$(git hash-object "$file")" != "$before" ]; then
            git add -- "$file"
            formatted="$formatted\n  $file"
        fi
    else
        # Partially staged: formatting would mix in unstaged edits, so only check the staged version.
        if ! git show ":$file" | swiftformat stdin --stdinpath "$file" --lint --quiet >/dev/null 2>&1; then
            failed="$failed\n  $file"
        fi
    fi
done

if [ -n "$formatted" ]; then
    printf "pre-commit: SwiftFormat reformatted and re-staged:%b\n" "$formatted"
fi

if [ -n "$failed" ]; then
    printf "pre-commit: these files need formatting (they also have unstaged changes):%b\n" "$failed" >&2
    echo "Run 'swiftformat <file>', review, stage, and commit again." >&2
    exit 1
fi
